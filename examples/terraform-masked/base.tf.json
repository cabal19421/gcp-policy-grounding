{
  "resource": {
    "google_compute_firewall": {
      "allow_rdp_broad": {
        "allow": [{"ports": ["3389"], "protocol": "tcp"}],
        "direction": "INGRESS",
        "name": "allow-rdp-broad",
        "network": "projects/acme-prod/global/networks/prod-vpc",
        "priority": 1000,
        "project": "acme-prod",
        "source_ranges": ["0.0.0.0/0"]
      },
      "deny_rdp": {
        "deny": [{"ports": ["3389"], "protocol": "tcp"}],
        "direction": "INGRESS",
        "name": "deny-external-rdp",
        "network": "projects/acme-prod/global/networks/prod-vpc",
        "priority": 900,
        "project": "acme-prod",
        "source_ranges": ["0.0.0.0/0"]
      }
    }
  }
}

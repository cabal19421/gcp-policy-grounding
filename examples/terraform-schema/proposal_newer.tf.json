{
  "resource": {
    "google_compute_firewall": {
      "allow_health_checks": {
        "allow": [{"ports": ["8080"], "protocol": "tcp"}],
        "direction": "INGRESS",
        "name": "allow-lb-health-checks",
        "network": "projects/acme-prod/global/networks/prod-vpc",
        "params": {
          "resource_manager_tags": {
            "tagKeys/281479612953454": "tagValues/281482091912447"
          }
        },
        "priority": 1000,
        "project": "acme-prod",
        "source_ranges": ["130.211.0.0/22", "35.191.0.0/16"],
        "target_tags": ["web"]
      }
    },
    "google_project_iam_binding": {
      "analysts": {
        "members": ["group:data-eng@acme.example"],

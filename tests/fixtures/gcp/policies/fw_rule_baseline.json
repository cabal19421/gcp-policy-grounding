{
  "kind": "compute#firewall",
  "name": "fw-allow-open",
  "network": "https://www.googleapis.com/compute/v1/projects/acme-prod/global/networks/vpc-main",
  "direction": "INGRESS",
  "priority": 1000,
  "disabled": false,
  "sourceRanges": ["10.0.0.0/8"],
  "allowed": [
    {"IPProtocol": "tcp", "ports": ["22"]},
    {"IPProtocol": "tcp", "ports": ["3389"]}
  ]
}

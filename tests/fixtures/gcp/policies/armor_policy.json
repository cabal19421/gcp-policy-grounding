{
  "kind": "compute#securityPolicy",
  "name": "armor-policy-prod",
  "description": "edge protection for the public API",
  "rules": [
    {
      "priority": 1000,
      "action": "deny-403",
      "preview": false,
      "description": "block a noisy scanner range",
      "match": {
        "versionedExpr": "SRC_IPS_V1",
        "config": {
          "srcIpRanges": ["203.0.113.0/24"]
        }
      }
    },
    {
      "priority": 2000,
      "action": "allow",
      "preview": false,
      "description": "allow the partner range",
      "match": {
        "versionedExpr": "SRC_IPS_V1",
        "config": {
          "srcIpRanges": ["198.51.100.0/24"]
        }
      }
    },
    {
      "priority": 2147483647,
      "action": "allow",
      "preview": false,
      "description": "default rule, higher priority overrides",
      "match": {
        "versionedExpr": "SRC_IPS_V1",
        "config": {
          "srcIpRanges": ["*"]
        }
      }
    }
  ]
}
